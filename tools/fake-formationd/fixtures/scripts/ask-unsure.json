{
  "description": "After ask to a person: received, then Formation is unsure which agent should answer and offers a choice",
  "steps": [
    {
      "event": { "type": "question.update", "payload": { "change": "upsert", "question": {
        "id": "{{id:q}}", "thread_id": "{{id:q}}", "asker": "01930000-0000-7000-8000-000000000001", "target": "{{params.target}}",
        "text": "{{params.text}}", "status": "received", "candidates": [], "agent_id": null,
        "answer": null, "error": null, "created_at": "{{now}}", "updated_at": "{{now}}"
      } } }
    },
    {
      "after_ms": 900,
      "event": { "type": "question.update", "payload": { "change": "upsert", "question": {
        "id": "{{id:q}}", "thread_id": "{{id:q}}", "asker": "01930000-0000-7000-8000-000000000001", "target": "{{params.target}}",
        "text": "{{params.text}}", "status": "unsure",
        "candidates": [
          { "agent_id": "01930000-0000-7000-8000-000000000201", "name": "Auth", "role": "Login and tokens", "score": 0.46, "reason": "Recently worked on the deploy script" },
          { "agent_id": "01930000-0000-7000-8000-000000000202", "name": "Frontend", "role": "Web UI", "score": 0.41, "reason": "Owns web deploy settings" },
          { "agent_id": "01930000-0000-7000-8000-000000000203", "name": "QA", "role": "Regression tests", "score": 0.22, "reason": "Pre-release tests" }
        ],
        "agent_id": null, "answer": null, "error": null, "created_at": "{{now}}", "updated_at": "{{now}}"
      } } }
    }
  ]
}
